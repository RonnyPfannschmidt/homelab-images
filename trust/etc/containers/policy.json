{
    "default": [
        {
            "type": "insecureAcceptAnything"
        }
    ],
    "transports": {
        "docker-daemon": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "docker": {
            "ghcr.io/ronnypfannschmidt": [
                {
                    "type": "sigstoreSigned",
                    "keyPaths": [
                        "/etc/pki/containers/cosign-2026-09.pub"
                    ],
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        }
    }
}
