# Nextcloud with the 9 apps the homeserver actually serves, baked in and
# pinned - the property the NixOS module gave us and a plain `nextcloud` image
# does not: the app set is part of the image, cannot drift, and moves only when
# apps.lock moves.
#
# Not a bootc image. It is an application container behind the Caddy that
# already fronts the box, and it is here rather than in the private repository
# because a public repository builds arm64 for free and publishes without a
# pull secret.

# Pinned by digest, not by tag, and the tag will move under it. This digest is
# the multi-arch index, so amd64 and arm64 both resolve from the one line.
#
# One major at a time, because Nextcloud's own `$OC_VersionCanBeUpgradedFrom`
# in version.php lists exactly the previous major and itself: 35 accepts 34.0
# and 35.0 and nothing else. The homeserver reached 34.0.4 on 2026-09-19, which
# is what makes this bump legal.
#
# **35.0.0 is a .0, and upstream does not recommend it yet.** `production` and
# `stable` on Docker Hub still resolve to 34.0.4 - read out of the image's own
# NEXTCLOUD_VERSION, not guessed - while `latest` has moved to 35.0.0. This pin
# is deliberately ahead of that channel and is not meant to be deployed until
# it catches up. Re-run `pin_apps.py --verify` when it does: the app feed moves
# with the platform, so the four pins below are a snapshot of 35.0.0's feed,
# not of whatever 35.0.x lands.
FROM docker.io/library/nextcloud:35.0.0-apache@sha256:23c101539e295aaf83888c9c1cae7df3fb6ce80b9ea9310248dad46af8c89936

# exiftool and ffmpeg are what `memories` needs and the base has neither;
# go-vod it ships itself, per-architecture, inside the app tarball.
#
# The archive is pinned to the snapshot the BASE IMAGE was built from, which
# the base records as a comment in its own sources file. Nothing is
# hand-maintained: the pin is a function of the FROM digest, so Renovate
# bumping the base moves the packages with it and never on its own.
#
# The pin is put back before the layer closes. Only the build is frozen; the
# shipped image carries upstream's own sources, so an `apt-get` in a running
# container reaches deb.debian.org and not a snapshot that ages out from under
# it. `mv` of a `cp -p` copy, so the restored file is byte-for-byte and
# mtime-for-mtime what the base shipped.
#
# The four log files and ldconfig's aux-cache are the only content in this
# layer that varies between two builds of the same tree - measured, not
# guessed. They hold wall-clock install times; deleting them is what makes the
# layer a function of its inputs.
#
# hadolint ignore=DL3008
RUN set -eu; \
    snap=$(awk -F/ '/^# http:\/\/snapshot\.debian\.org\/archive\/debian\/[0-9TZ]+$/ \
        { print $NF; exit }' /etc/apt/sources.list.d/debian.sources); \
    test -n "$snap"; \
    cp -p /etc/apt/sources.list.d/debian.sources /tmp/sources.orig; \
    sed -i -e "s|^URIs: http://deb.debian.org/debian$|URIs: http://snapshot.debian.org/archive/debian/$snap|" \
           -e "s|^URIs: http://deb.debian.org/debian-security$|URIs: http://snapshot.debian.org/archive/debian-security/$snap|" \
        /etc/apt/sources.list.d/debian.sources; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        libimage-exiftool-perl; \
    mv /tmp/sources.orig /etc/apt/sources.list.d/debian.sources; \
    rm -f /etc/apt/apt.conf.d/99snapshot; \
    rm -rf /var/lib/apt/lists/* /var/log/apt /var/cache/ldconfig/aux-cache; \
    rm -f /var/log/dpkg.log /var/log/alternatives.log

# custom_apps, which the base image already declares in its own apps.config.php
# and already serves. Nothing downstream has to be told where these are: the
# image is self-contained and a fresh install comes up with the full app set.
#
# There is no exclude list to edit any more. The rsync this used to fight is
# gone with the entrypoint - see the webroot step below - so custom_apps is
# simply part of the read-only layer, and an app installed through the web UI
# cannot land there at all. The image owns the app set; apps.lock is how it
# changes.

COPY apps/nextcloud/apps.lock /tmp/apps.lock
# Pipe-free on purpose: a pipe here would need `SHELL -o pipefail` for the whole
# file, and a `sha256sum -c` whose exit status is swallowed is the one failure
# this step exists to catch.
RUN set -eu; \
    mkdir -p /usr/src/nextcloud/custom_apps; \
    expected=0; \
    while read -r app version sha url; do \
        case "$app" in ''|\#*) continue ;; esac; \
        echo "==> $app $version"; \
        expected=$((expected + 1)); \
        curl -fsSL -o /tmp/app.tar.gz "$url"; \
        printf '%s  %s\n' "$sha" /tmp/app.tar.gz > /tmp/app.sha256; \
        sha256sum -c /tmp/app.sha256; \
        tar -xzf /tmp/app.tar.gz -C /usr/src/nextcloud/custom_apps; \
        test -d "/usr/src/nextcloud/custom_apps/$app" \
            || { echo "$app: tarball did not unpack to $app/" >&2; exit 1; }; \
        rm /tmp/app.tar.gz /tmp/app.sha256; \
    done < /tmp/apps.lock; \
    rm /tmp/apps.lock; \
    set -- /usr/src/nextcloud/custom_apps/*/; \
    test "$#" = "$expected" \
        || { echo "unpacked $# apps, apps.lock names $expected" >&2; exit 1; }

# The webroot, baked and immutable, and the step this image exists for.
#
# The base image ships an EMPTY /var/www/html, declares it a VOLUME, and keeps
# the real 2.0 GB at /usr/src/nextcloud for its entrypoint to rsync across on
# every start. Measured 2026-09-17, that arrangement has no good setting:
#
#   anonymous volume + --rm   a genuine 2.0 GB copy on every start. It is not
#                             reflinked even on btrfs - the image blob and the
#                             volume copy occupy different physical extents.
#   named volume              populated from the image exactly once, on first
#                             start, and never re-synced. Content deleted from
#                             it stays deleted; a NEWER image's files never
#                             arrive. The webroot silently freezes.
#
# A VOLUME an ancestor declared cannot be un-declared, so the move is to stop
# using that path. /var/www/nextcloud is ours and ordinary: the code is read
# straight out of the layer, an image bump replaces it because that is what a
# layer does, and nothing is copied at start.
#
# /var/www/html stays behind as an empty directory. podman still creates an
# empty anonymous volume over it on every run; it costs nothing and nothing
# reads it.
#
# The tree is root-owned and unwritable to www-data on purpose. config/ and
# data/ are mount points - a deployment binds real directories over them - so a
# container started without those mounts fails loudly instead of quietly
# writing state into a layer that is about to be thrown away.
# config/ is emptied rather than left holding upstream's templates. They are
# shadowed by the bind mount in every real deployment, so keeping them would
# only mean the image behaves differently when run without one - apcu as the
# local cache, a different apps_paths - which is the kind of difference that is
# discovered in production. The instance's config.php and its overrides are the
# only configuration this image reads.
#
# hadolint ignore=SC2016
RUN set -eu; \
    mv /usr/src/nextcloud /var/www/nextcloud; \
    rm -f /upgrade.exclude /entrypoint.sh /cron.sh; \
    rm -rf /var/www/nextcloud/config; \
    mkdir -p /var/www/nextcloud/config /var/www/nextcloud/data; \
    chown -R root:root /var/www/nextcloud; \
    chmod -R go-w /var/www/nextcloud; \
    test ! -e /var/www/nextcloud/config/config.php; \
    test ! -e /entrypoint.sh; \
    php -r 'require "/var/www/nextcloud/version.php"; echo implode(".", $OC_Version), "\n";'

# DocumentRoot, and the front-controller rewrite rules that used to be written
# into .htaccess at start. See the file itself - the ordering rule in it is the
# one thing here that is not obvious.
COPY apps/nextcloud/etc/nextcloud-site.conf /etc/apache2/sites-available/nextcloud.conf
RUN set -eu; \
    a2dissite 000-default; \
    a2ensite nextcloud; \
    a2enmod rewrite headers env dir mime setenvif; \
    apache2ctl configtest

COPY apps/nextcloud/etc/mpm.conf /etc/apache2/conf-enabled/zzz-mpm.conf
COPY apps/nextcloud/etc/nextcloud.ini /usr/local/etc/php/conf.d/zzz-nextcloud.ini

# The role dispatcher, and this image's only start-up logic - the upstream
# entrypoint is deleted above, not merely bypassed, so nothing can fall back to
# it by accident. `web`, `cron`, `occ`, `upgrade` and `versions` are the roles;
# anything else runs as given.
#
# `upgrade` being a role of its own is the point. Upstream migrates the database
# from inside the web container's start, which means an image bump and an
# irreversible schema change are one event and the rollback window is zero.
# Here the new code starts against the old database, Nextcloud says so, and the
# migration is a separate thing someone runs.
COPY --chmod=755 apps/nextcloud/bin/nextcloud-role /usr/local/bin/nextcloud-role
ENTRYPOINT ["/usr/local/bin/nextcloud-role"]
CMD ["web"]
