# The synchronous OpenAI image facade over Olares' Router; see routerimages.py.
#
# Standard library only, so the base is the whole dependency set. Pinned by
# the multi-arch index digest; Renovate moves it.
FROM docker.io/library/python:3.14-slim@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8

COPY apps/routerimages/routerimages.py /app/routerimages.py

# Not root: Olares' admission policy refuses a root container from an image
# outside its allowlist, and nothing here needs it.
USER 65534:65534
EXPOSE 8080
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "-I", "/app/routerimages.py"]
