FROM quay.io/fedora/fedora-silverblue:44@sha256:d60d4e35498c73daa896b6e324843837424a2e5dd132878f53fb5fb515a4b5cd

RUN dnf install -y \
    # Dev tools
    uv \
    stow \
    # code \
    # Utilities
    the_silver_searcher \
    tree \
    which \
    file \
    jq \
    # Security
    pass-otp \
    pass-audit \
    gnupg2 \
    qtpass \
    # VCS
    git \
    gitk \
    git-annex \
    # System
    psmisc \
    lsof \
    && dnf clean all

# Trust material, shared by every image here and copied from the repository
# root - which is why this image builds with the root as its context.
#
# The running image carries the keys that verify the *next* one, so this is
# what makes `bootc upgrade` checkable at all, and what makes a key rotation an
# ordered procedure rather than a flag flip. See trust/README.md and
# docs/signing.md. With trust/keys/ empty the policy enforces nothing and this
# is inert.
COPY trust/etc/ /etc/
COPY trust/keys/ /etc/pki/containers/
