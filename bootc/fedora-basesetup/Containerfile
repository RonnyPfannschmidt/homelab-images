# The lockfile and its reader, staged so the RUN below can bind-mount them.
# Neither belongs in the image: a COPY would put both in a layer that a later
# `rm` cannot take back out, and the running system has no use for either. A
# bind mount from `scratch` leaves nothing behind and, unlike mounting the
# build context directly, relabels nothing on the host.
FROM scratch AS lockfiles
COPY bootc/fedora-basesetup/rpms.lock.yaml /rpms.lock.yaml
COPY bootc/fedora-basesetup/install_lock.py /install_lock.py

FROM quay.io/fedora/fedora-silverblue:44@sha256:60e51286809ac009bda4becfc041f47f893cbc038c057341b4781a6f79b96f3a

# rpm stamps a wall-clock INSTALLTIME and INSTALLTID into the rpmdb for every
# package, and the rpmdb cannot be deleted - it is the one thing in this image
# that --rewrite-timestamp cannot reach, because it is file content and not an
# mtime. rpm honours SOURCE_DATE_EPOCH for both, so declaring the ARG is the
# whole fix: podman populates it from --source-date-epoch, and dnf inherits it.
ARG SOURCE_DATE_EPOCH

# Every package, pinned by URL and sha256 in rpms.lock.yaml, installed with
# every repository disabled. The build reaches the network for exactly the
# bytes the lockfile names and resolves against nothing - so the package set
# is a property of the committed file, not of what Fedora served this morning.
#
# rpms.in.yaml is the input; relock.py resolves it against the base image's
# own rpmdb and writes the lock. That makes the lock stale on every digest bump
# below, and Renovate cannot relock - its PR fails pre-commit until relock.py
# has run on the branch.
RUN --mount=type=bind,from=lockfiles,target=/lock \
    set -eu; \
    python3 /lock/install_lock.py /lock/rpms.lock.yaml; \
    dnf clean all; \
    rm -rf /usr/lib/sysimage/libdnf5/transaction_history.sqlite* \
           /var/lib/dnf/repos /var/log/dnf5.log \
           /var/cache/ldconfig/aux-cache

# Trust material, shared by every image here and copied from the repository
# root - which is why this image builds with the root as its context.
#
# The running image carries the keys that verify the *next* one, so this is
# what makes `bootc upgrade` checkable at all, and what makes a key rotation an
# ordered procedure rather than a flag flip. See trust/README.md and
# docs/signing.md. With trust/keys/ empty the policy enforces nothing and this
# is inert.
COPY trust/etc/ /etc/
COPY trust/keys/ /etc/pki/containers/
